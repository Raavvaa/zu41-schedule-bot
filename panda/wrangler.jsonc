{
  "name": "panda-personal-agent",
  "main": "src/index.mjs",
  "compatibility_date": "2026-07-30",
  "workers_dev": true,
  "observability": {
    "enabled": false
  },
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  },
  "vars": {
    "ENABLED": "false",
    "GROQ_MODEL": "openai/gpt-oss-20b",
    "OPENROUTER_MODEL": "openrouter/free",
    "GROQ_DAILY_TOKENS": "200000",
    "GROQ_DAILY_REQUESTS": "500",
    "SILICONFLOW_DAILY_TOKENS": "500000",
    "SILICONFLOW_DAILY_REQUESTS": "1000",
    "OPENROUTER_DAILY_TOKENS": "50000",
    "OPENROUTER_DAILY_REQUESTS": "100",
    "SILICONFLOW_BASE_URL": "https://api.siliconflow.com/v1",
    "SILICONFLOW_CHAT_MODEL": "Qwen/Qwen2.5-7B-Instruct",
    "SILICONFLOW_EMBED_MODEL": "Qwen/Qwen3-Embedding-0.6B",
    "FREE_ONLY": "true",
    "PEER_DEBOUNCE_MS": "4000",
    "WORKERS_AI_ENABLED": "true",
    "WORKERS_AI_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast",
    "WORKERS_AI_TIMEOUT_MS": "4500",
    "CLOUDFLARE_DAILY_TOKENS": "200000",
    "CLOUDFLARE_DAILY_REQUESTS": "500"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "panda-personal-agent",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "ai": {
    "binding": "AI"
  }
}
